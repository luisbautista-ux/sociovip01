rules_version = '2';

// Documentación de Storage Rules: https://firebase.google.com/docs/storage/security
service firebase.storage {
  match /b/{bucket}/o {

    // --- REGLA DE DEPURACIÓN ---
    // AVISO: Esta regla es para propósitos de depuración.
    // Permite a CUALQUIER usuario autenticado leer y escribir en CUALQUIER parte del Storage.
    // Es insegura para producción. Una vez que se resuelva el problema de subida,
    // se deben restaurar reglas más específicas.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
