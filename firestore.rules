rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to get the user's profile data
    function getUserProfile() {
      return get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Reglas para la colección de negocios
    match /businesses/{businessId} {
      allow read: if true; // Publicly readable for business pages
      allow list, create, update, delete: if isSignedIn() && getUserProfile().roles.includes('superadmin');
    }

    // Reglas para los perfiles de usuario de la plataforma (admins, staff, etc.)
    match /platformUsers/{userId} {
      allow read: if isSignedIn(); // Any signed-in user can read profiles (e.g., for checks)
      allow list: if isSignedIn() && getUserProfile().roles.includes('superadmin');
      allow create, update, delete: if isSignedIn() && getUserProfile().roles.includes('superadmin');
      // A user can update their own profile
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para los miembros de SocioVIP
    match /socioVipMembers/{memberId} {
      allow read, create, update, delete: if isSignedIn() && getUserProfile().roles.includes('superadmin');
    }

    // Reglas para los clientes QR (generados por promotores)
    match /qrClients/{clientId} {
      // Superadmin can manage all
      allow read, list, create, update, delete: if isSignedIn() && getUserProfile().roles.includes('superadmin');
      // Business admins/staff can read clients associated with their business
      allow read: if isSignedIn() && (
        (getUserProfile().roles.includes('business_admin') || getUserProfile().roles.includes('staff')) &&
        (resource.data.associatedBusinessIds.hasAny([getUserProfile().businessId]) || resource.data.generatedForBusinessId == getUserProfile().businessId)
      );
      // Allow creation publicly (from business page) - NO AUTH REQUIRED
      allow create: if true;
    }

    // Reglas para las entidades de negocio (promociones, eventos)
    match /businessEntities/{entityId} {
      allow read: if true; // Publicly readable for business pages
      allow create, update, delete: if isSignedIn() && (
        getUserProfile().roles.includes('superadmin') || 
        ( (getUserProfile().roles.includes('business_admin') || getUserProfile().roles.includes('staff')) 
           && getUserProfile().businessId == request.resource.data.businessId )
      );
      // Allow business admin/staff to list entities where businessId matches their profile's businessId
      allow list: if isSignedIn() && (
        getUserProfile().roles.includes('superadmin') ||
        ( (getUserProfile().roles.includes('business_admin') || getUserProfile().roles.includes('staff'))
           && getUserProfile().businessId != null )
      );
    }
    
    // Reglas para los vínculos entre negocio y promotor
    match /businessPromoterLinks/{linkId} {
      // Superadmin and relevant business admin/staff can manage links.
      allow read, create, update, delete: if isSignedIn() && (
        getUserProfile().roles.includes('superadmin') ||
        ( (getUserProfile().roles.includes('business_admin') || getUserProfile().roles.includes('staff')) 
           && getUserProfile().businessId == request.resource.data.businessId )
      );
       // Allow business admin/staff to list links for their business
      allow list: if isSignedIn() && (
        getUserProfile().roles.includes('superadmin') ||
        ( (getUserProfile().roles.includes('business_admin') || getUserProfile().roles.includes('staff'))
           && getUserProfile().businessId != null )
      );
    }
    
    // Reglas para la nueva colección de pagos a promotores
    match /promoterPayments/{paymentId} {
      allow read, list, create: if isSignedIn() && (
        getUserProfile().roles.includes('superadmin') ||
        ( (getUserProfile().roles.includes('business_admin') || getUserProfile().roles.includes('staff'))
           && getUserProfile().businessId == request.resource.data.businessId )
      );
      allow update, delete: if isSignedIn() && getUserProfile().roles.includes('superadmin');
    }
  }
}
