rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check if the user has a specific role
    function hasRole(role) {
      return get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.roles.hasAny([role]);
    }
    
    // Helper function to check if the user is associated with a specific business
    function isMemberOfBusiness(businessId) {
      return get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.businessId == businessId;
    }
    
    // Helper function to check if the promoter is assigned to the business (for multi-business promoters)
    function isAssignedToBusiness(businessId) {
       return get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data.businessIds.hasAny([businessId]);
    }
    
    // Helper to get user profile
    function getUserProfile() {
      return get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data;
    }

    // Businesses: Superadmins can manage everything.
    // Business admins can read their own business data for settings and other displays.
    match /businesses/{businessId} {
      allow read: if request.auth != null; // All authenticated users can read public business data.
      allow write: if hasRole('superadmin'); // Only superadmins can create, update, delete businesses.
      allow update: if hasRole('superadmin') || isMemberOfBusiness(businessId); // Business admin can update their own.
    }
    
    // platformUsers: Superadmins manage all users.
    // Users can read/update their own profile.
    match /platformUsers/{userId} {
      allow read: if hasRole('superadmin') || request.auth.uid == userId;
      allow write: if hasRole('superadmin'); // Creation/deletion only by superadmin
      allow update: if hasRole('superadmin') || request.auth.uid == userId;
    }
    
    // socioVipMembers: Superadmins manage all.
    match /socioVipMembers/{memberId} {
      allow read, write: if hasRole('superadmin');
    }
    
    // qrClients: Superadmins can read all.
    // Business admins/staff can read clients associated with their business.
    match /qrClients/{clientId} {
      allow read: if request.auth != null; // Public can read for QR generation, server validates
      allow write: if request.auth != null; // Public can write to create their own profile
      allow list: if hasRole('superadmin') || hasRole('business_admin') || hasRole('staff');
    }

    // businessEntities (Promotions/Events):
    // Public can read.
    // Business admins/staff can manage entities for their own business.
    // Promoters can read entities they are assigned to.
    match /businessEntities/{entityId} {
      allow read: if request.auth != null;
      allow write: if hasRole('superadmin') || (
        (hasRole('business_admin') || hasRole('staff')) && 
        isMemberOfBusiness(request.resource.data.businessId)
      );
      allow update: if hasRole('superadmin') || (
        (hasRole('business_admin') || hasRole('staff')) && 
        isMemberOfBusiness(resource.data.businessId)
      );
      allow delete: if hasRole('superadmin') || (
        (hasRole('business_admin') || hasRole('staff')) && 
        isMemberOfBusiness(resource.data.businessId)
      );
    }
    
    // businessPromoterLinks:
    // Business admins/staff can manage links for their business.
    // Promoters can read links they are part of.
    match /businessPromoterLinks/{linkId} {
      allow read: if hasRole('superadmin') || 
                     isMemberOfBusiness(resource.data.businessId) || 
                     resource.data.platformUserUid == request.auth.uid;
      allow write: if hasRole('superadmin') || isMemberOfBusiness(request.resource.data.businessId);
      allow update, delete: if hasRole('superadmin') || isMemberOfBusiness(resource.data.businessId);
    }

    // promoterPayments:
    // Business admins/staff can manage payments for their business.
    // Promoters can read payments made to them.
    match /promoterPayments/{paymentId} {
      allow read: if hasRole('superadmin') || 
                     isMemberOfBusiness(resource.data.businessId) || 
                     resource.data.promoterUid == request.auth.uid;
      allow write: if hasRole('superadmin') || isMemberOfBusiness(request.resource.data.businessId);
    }
  }
}
