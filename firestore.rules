rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================== 
    //            Helpers
    // ===============================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      // Use the 'exists' function to safely access data that might not exist yet.
      return get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data;
    }
    
    function userHasRole(role) {
        return isSignedIn() && getUserData().roles.includes(role);
    }
    
    function isSuperAdmin() {
      return userHasRole('superadmin');
    }

    function isRoleForBusiness(role, businessId) {
      return userHasRole(role) && getUserData().businessId == businessId;
    }

    function isBusinessAdmin(businessId) {
      return isRoleForBusiness('business_admin', businessId);
    }

    function isStaff(businessId) {
      return isRoleForBusiness('staff', businessId);
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ===============================
    //          Collections
    // ===============================

    match /businesses/{businessId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /businessEntities/{entityId} {
      allow get: if true; 
      
      // A business user can list entities IF they are querying for their own businessId.
      allow list: if isSuperAdmin() || 
                     (isSignedIn() && request.query.businessId == getUserData().businessId);
      
      allow create: if isSuperAdmin() || isBusinessAdmin(request.resource.data.businessId) || isStaff(request.resource.data.businessId);
      allow update: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId) || isStaff(resource.data.businessId);
      allow delete: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId);
    }

    match /businessPromoterLinks/{linkId} {
        allow get: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId) || isStaff(resource.data.businessId);
        
        // A business user can list links IF they are querying for their own businessId.
        allow list: if isSuperAdmin() || 
                     (isSignedIn() && request.query.businessId == getUserData().businessId);

        allow create, update, delete: if isSuperAdmin() || isBusinessAdmin(request.resource.data.businessId) || isStaff(request.resource.data.businessId);
    }

    match /promoterPayments/{paymentId} {
        // A business user can manage payments for their own business.
        allow read, write: if isSuperAdmin() || 
                             (isSignedIn() && (
                               (request.method in ['get', 'list'] && request.query.businessId == getUserData().businessId) ||
                               (request.method in ['create', 'update', 'delete'] && request.resource.data.businessId == getUserData().businessId)
                             ));
    }

    match /qrClients/{clientId} {
      allow read, list: if true; // Allow wide read access for now
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /socioVipMembers/{memberId} {
      allow read, list, create, update, delete: if isSuperAdmin();
    }

    match /platformUsers/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }
  }
}
