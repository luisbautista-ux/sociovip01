rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== REGLAS DE LECTURA PÚBLICA =====

    // Cualquiera puede leer la lista de negocios para la página principal
    match /businesses/{businessId} {
      allow read: if true;
    }

    // Cualquiera puede leer las promociones/eventos para listarlas
    match /businessEntities/{entityId} {
      allow read: if true;
    }

    // ===== REGLAS DE ESCRITURA Y LECTURA RESTRINGIDA =====

    // Colección: platformUsers
    // Almacena los perfiles de todos los usuarios de la plataforma (admins, staff, etc.)
    match /platformUsers/{userId} {
      // Un usuario solo puede leer su propio perfil.
      allow read: if request.auth != null && request.auth.uid == userId;

      // El Super Admin puede leer cualquier perfil.
      allow read: if request.auth != null && isSuperAdmin();

      // Un usuario puede actualizar su propio nombre, teléfono y foto.
      // El DNI, email, roles y businessId solo los puede cambiar un Super Admin.
      allow update: if request.auth != null && request.auth.uid == userId
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'photoURL', 'lastLogin']);

      // El Super Admin puede crear y actualizar cualquier perfil sin restricciones de campos.
      allow write: if request.auth != null && isSuperAdmin();
    }

    // Colección: socioVipMembers
    // Almacena a los clientes que son parte del programa Socio VIP.
    match /socioVipMembers/{memberId} {
      // El Super Admin puede hacer todo (CRUD).
      allow read, write, delete: if request.auth != null && isSuperAdmin();
    }

    // Colección: qrClients
    // Almacena a los clientes que han generado un QR al menos una vez.
    match /qrClients/{clientId} {
      // El Super Admin puede leer todos los clientes.
      allow read: if request.auth != null && isSuperAdmin();
      // Nadie más debe poder escribir directamente aquí.
      allow write: if false;
    }
    
    // Colección: businessPromoterLinks
    // Almacena los vínculos entre un negocio y un promotor.
    match /businessPromoterLinks/{linkId} {
        // Solo un Super Admin o un Admin/Staff del negocio correspondiente puede leer los vínculos.
        allow read: if request.auth != null && (isSuperAdmin() || userIsAdminOrStaffOfBusiness(resource.data.businessId));
        
        // Solo un Super Admin o un Admin/Staff del negocio correspondiente puede crear, actualizar o borrar vínculos.
        allow write: if request.auth != null && (isSuperAdmin() || userIsAdminOrStaffOfBusiness(request.resource.data.businessId));
    }
    
    // Colección: promoterPayments
    // Almacena los registros de pagos de comisiones a promotores.
    match /promoterPayments/{paymentId} {
      // Solo Super Admin o Admin/Staff del negocio pueden leer o escribir pagos.
      allow read, write: if request.a