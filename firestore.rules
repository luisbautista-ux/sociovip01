rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================== 
    //            Helpers
    // ===============================
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserProfile().roles.includes('superadmin');
    }
    
    function isRoleForBusiness(role, businessId) {
      return isSignedIn()
        && getUserProfile().roles.includes(role)
        && getUserProfile().businessId == businessId;
    }

    function isBusinessAdmin(businessId) {
      return isRoleForBusiness('business_admin', businessId);
    }

    function isStaff(businessId) {
      return isRoleForBusiness('staff', businessId);
    }

    function isHost(businessId) {
      return isRoleForBusiness('host', businessId);
    }

    function isPromoter() {
      return isSignedIn() && getUserProfile().roles.includes('promoter');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ===============================
    //          Collections
    // ===============================

    match /businesses/{businessId} {
      allow read: if true;
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || 
                      (isBusinessAdmin(businessId) && request.resource.data.diff(resource.data).changedKeys().hasOnly(['personalPhone', 'publicPhone', 'slogan', 'logoUrl', 'publicCoverImageUrl', 'primaryColor', 'secondaryColor', 'publicAddress', 'publicContactEmail', 'name', 'contactEmail']));
    }

    match /businessEntities/{entityId} {
      allow get: if true; // Permite leer un documento si se conoce el ID
      allow list: if isSignedIn(); // Permite listar (hacer queries) si está logueado
      
      allow create: if isSuperAdmin() || isBusinessAdmin(request.resource.data.businessId) || isStaff(request.resource.data.businessId);
      allow update: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId) || isStaff(resource.data.businessId);
      allow delete: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId);
    }

    match /qrClients/{clientId} {
      allow get, list: if true;
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /platformUsers/{userId} {
      allow read: if isSignedIn();
      
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        getUserProfile().roles.includes('business_admin') &&
        request.resource.data.businessId == getUserProfile().businessId &&
        request.resource.data.roles.hasOnly(['staff', 'host', 'lector_qr'])
      );

      allow update: if isSuperAdmin() || (
        isSignedIn() && (
          (isPromoter() && isOwner(userId)) ||
          (isBusinessAdmin(getUserProfile().businessId) && resource.data.businessId == getUserProfile().businessId)
        )
      );
      
      allow delete: if isSuperAdmin() || (
        isSignedIn() &&
        isBusinessAdmin(getUserProfile().businessId) &&
        resource.data.businessId == getUserProfile().businessId &&
        !resource.data.roles.includes('superadmin')
      );
    }

    match /businessPromoterLinks/{linkId} {
      allow get, list: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId) || isPromoter();
      allow create, update: if isSuperAdmin() || isBusinessAdmin(request.resource.data.businessId);
      allow delete: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId);
    }

    match /socioVipMembers/{memberId} {
      allow get, list: if isSuperAdmin() || (
        isSignedIn() && (
          getUserProfile().roles.includes('business_admin') || getUserProfile().roles.includes('staff')
        )
      );
      allow create, update, delete: if isSuperAdmin();
    }
    
    match /promoterPayments/{paymentId} {
      allow get, list, create: if isSuperAdmin() || isBusinessAdmin(getUserProfile().businessId);
      allow update, delete: if isSuperAdmin();
    }
  }
}
