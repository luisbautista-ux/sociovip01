rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funciones de Ayuda (Helpers) ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      // Obtiene los datos del perfil del usuario que hace la petición.
      return get(/databases/$(database)/documents/platformUsers/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      // CORRECTO: usar 'in' para verificar la existencia de un string en una lista
      return isSignedIn() && 'superadmin' in getUserData().roles;
    }

    function isBusinessAdmin(businessId) {
      // CORRECTO: usar 'in' para verificar la existencia de un string en una lista
      return isSignedIn() && 'business_admin' in getUserData().roles && getUserData().businessId == businessId;
    }
    
    function isStaff(businessId) {
      // CORRECTO: usar 'in' para verificar la existencia de un string en una lista
      return isSignedIn() && 'staff' in getUserData().roles && getUserData().businessId == businessId;
    }
    
    // Un miembro del negocio es Admin o Staff
    function isBusinessMember(businessId) {
        return isBusinessAdmin(businessId) || isStaff(businessId);
    }
    
    // Verifica si el usuario es miembro de CUALQUIER negocio (admin, staff o lector)
    function isAnyBusinessMember() {
      let userRoles = getUserData().roles;
      return isSignedIn() && ('business_admin' in userRoles || 'staff' in userRoles || 'lector_qr' in userRoles);
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Reglas por Colección ---

    // Colección de Negocios
    match /businesses/{businessId} {
      allow read: if true; // Lectura pública para todos
      
      // SuperAdmin o un miembro de ese negocio puede actualizar
      allow write: if isSuperAdmin() || isBusinessMember(businessId);
    }
    
    // Colección de Entidades (Promociones y Eventos)
    match /businessEntities/{entityId} {
      allow read: if true; // Lectura pública
      // Para crear, se valida el businessId del nuevo recurso
      allow create: if isSuperAdmin() || isBusinessMember(request.resource.data.businessId);
      // Para actualizar/eliminar, se valida el businessId del recurso existente
      allow update, delete: if isSuperAdmin() || isBusinessMember(resource.data.businessId);
    }
    
    // Colección de Usuarios de la Plataforma
    match /platformUsers/{userId} {
      // Cualquiera autenticado puede leer perfiles.
      allow read: if isSignedIn();

      // CREAR: Un usuario puede ser creado de dos maneras:
      // 1. Un usuario nuevo crea su propio perfil al registrarse.
      // 2. Un SuperAdmin o BusinessAdmin crea un nuevo perfil para alguien más.
      allow create: if request.auth.uid == userId ||
                      isSuperAdmin() ||
                      (isBusinessAdmin(request.resource.data.businessId));

      // ACTUALIZAR: Un usuario puede ser actualizado por:
      // 1. Él mismo (para editar su propio perfil).
      // 2. Un SuperAdmin (puede editar a cualquiera).
      // 3. Un Admin o Staff del negocio al que pertenece el usuario.
      allow update: if isOwner(userId) ||
                      isSuperAdmin() ||
                      isBusinessMember(resource.data.businessId);

      // BORRAR: Un usuario puede ser borrado por:
      // 1. Un SuperAdmin.
      // 2. Un Admin del negocio al que pertenece el usuario.
      allow delete: if isSuperAdmin() ||
                      isBusinessAdmin(resource.data.businessId);
    }
    
    // Vínculos de Promotores con Negocios
    match /businessPromoterLinks/{linkId} {
        // SuperAdmin, el Admin del negocio, o cualquier promotor puede leer los vínculos
        allow read: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId) || ('promoter' in getUserData().roles);
        // Solo SuperAdmin o Admin del negocio pueden crear/actualizar/eliminar
        allow write: if isSuperAdmin() || isBusinessAdmin(request.resource.data.businessId);
    }
    
    // Socios VIP
    match /socioVipMembers/{memberId} {
       // Solo el SuperAdmin puede gestionar (leer y escribir) la lista de Socios VIP
       allow read, write: if isSuperAdmin();
    }
    
    // Clientes QR
    match /qrClients/{clientId} {
      allow create: if true; // Cualquiera puede crear un cliente QR
      // Los miembros de negocio pueden leer la lista (el filtrado ocurre en la app)
      allow read: if isSuperAdmin() || isAnyBusinessMember();
      allow update, delete: if false;
    }

    // Configuración de la Plataforma
    match /platformSettings/{configId} {
      allow read: if isSignedIn(); // Cualquier usuario logueado puede leer la configuración
      allow write: if isSuperAdmin(); // Solo SuperAdmin puede escribir
    }
    
    // Pagos de Comisiones de Promotores
    match /promoterPayments/{paymentId} {
        // Solo SuperAdmin o Admin del negocio pueden leer o registrar pagos
        allow read, write: if isSuperAdmin() || isBusinessMember(request.resource.data.businessId);
    }

    // Reglas para el Piloto Automático de Marketing
    match /automationRules/{ruleId} {
      // El businessId está en el ID del documento (ej: "businessId123_loyalty")
      // Solo los miembros de ese negocio o un SuperAdmin pueden leer/escribir.
      allow read, write: if isSuperAdmin() || isBusinessMember(ruleId.split('_')[0]);
    }
  }
}
